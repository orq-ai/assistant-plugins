{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "orq-claude-plugin",
  "version": "0.2.0",
  "description": "Orq plugins for Claude Code \u2014 tracing, MCP tools, and agent skills",
  "owner": {
    "name": "Orq AI",
    "email": "support@orq.ai"
  },
  "plugins": [
    {
      "name": "orq-trace",
      "description": "Automatically trace Claude Code sessions to Orq. Captures sessions, turns, tool calls, and LLM responses as hierarchical OTLP spans.",
      "version": "0.6.0",
      "author": {
        "name": "Orq AI"
      },
      "license": "MIT",
      "keywords": [
        "orq",
        "claude-code",
        "otel",
        "otlp",
        "tracing"
      ],
      "source": "./plugins/trace-hooks",
      "category": "observability",
      "strict": false,
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "PostToolUseFailure": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-failure.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.js\"",
                "async": false,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "StopFailure": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-failure.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.js\"",
                "async": false,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop.js\"",
                "async": true,
                "silent": true,
                "timeout": 30
              }
            ]
          }
        ]
      },
      "userConfig": {
        "ORQ_API_KEY": {
          "title": "Orq API Key",
          "description": "Optional. Leave blank to use ORQ_API_KEY env var or the orqi CLI profile (see plugin docs for resolution order).",
          "type": "string",
          "sensitive": true,
          "required": false
        }
      }
    },
    {
      "name": "orq-skills",
      "description": "Agent skills for building, evaluating, and optimizing LLM pipelines on orq.ai. Includes skills for experiment design, prompt optimization, trace analysis, dataset generation, and agent/evaluator creation.",
      "source": "./",
      "category": "development"
    },
    {
      "name": "orq-mcp",
      "description": "MCP server for interacting with your orq.ai workspace \u2014 manage agents, deployments, datasets, experiments, traces, and more.",
      "source": "./",
      "category": "development"
    }
  ]
}
