{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orq-find-cost-savings report.json",
  "$defs": {
    "Ask": {
      "properties": {
        "span_id": {},
        "used": {},
        "recommended": {},
        "differs": {
          "type": "boolean"
        }
      },
      "required": [
        "span_id",
        "used",
        "recommended",
        "differs"
      ],
      "type": "object"
    },
    "CacheRow": {
      "properties": {
        "thread": {},
        "agent": {},
        "model": {},
        "turns": {},
        "savings": {},
        "action": {}
      },
      "required": [
        "thread",
        "agent",
        "model",
        "turns",
        "savings",
        "action"
      ],
      "type": "object"
    },
    "Caching": {
      "properties": {
        "threads_scanned": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "savings_found": {
          "type": "number"
        },
        "savings_orq": {
          "type": "number"
        },
        "rows": {
          "items": {},
          "type": "array"
        },
        "error": {
          "type": "string"
        },
        "cached_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_by_cache": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "threads_caching": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Caveat": {
      "properties": {
        "check": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "detail"
      ],
      "type": "object"
    },
    "Checks": {
      "properties": {
        "stopping": {
          "items": {
            "$ref": "#/$defs/StoppingCheck"
          },
          "type": "array"
        },
        "caveats": {
          "items": {
            "$ref": "#/$defs/Caveat"
          },
          "type": "array"
        }
      },
      "required": [
        "stopping",
        "caveats"
      ],
      "type": "object"
    },
    "CounterfactualTest": {
      "properties": {
        "asks": {
          "items": {
            "$ref": "#/$defs/Ask"
          },
          "type": "array"
        },
        "per_model": {
          "type": "object"
        }
      },
      "required": [
        "asks",
        "per_model"
      ],
      "type": "object"
    },
    "Estimate": {
      "properties": {
        "savings": {
          "type": "number"
        },
        "ci90": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "per_month": {
          "type": "number"
        },
        "ci90_per_month": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "without_top3": {
          "type": "number"
        },
        "unpriced_models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "per_stratum": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "savings",
        "ci90",
        "coverage",
        "per_month",
        "ci90_per_month",
        "without_top3",
        "unpriced_models"
      ],
      "type": "object"
    },
    "Harness": {
      "properties": {
        "metric": {
          "type": "string"
        },
        "rows": {
          "items": {},
          "type": "array"
        },
        "unattributed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Headline": {
      "properties": {
        "savings": {
          "type": "number"
        },
        "ci90": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "without_top3": {
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "per_month": {
          "type": "number"
        },
        "ci90_per_month": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "savings",
        "ci90",
        "without_top3",
        "coverage",
        "per_month",
        "ci90_per_month"
      ],
      "type": "object"
    },
    "Move": {
      "properties": {
        "pool": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "switch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pool",
        "switch"
      ],
      "type": "object"
    },
    "NotAnalysed": {
      "properties": {
        "per_month": {
          "type": "number"
        },
        "model_count": {
          "type": "integer"
        }
      },
      "required": [
        "per_month",
        "model_count"
      ],
      "type": "object"
    },
    "NotCovered": {
      "properties": {
        "model": {
          "type": "string"
        },
        "spend": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "spend",
        "reason"
      ],
      "type": "object"
    },
    "Params": {
      "properties": {
        "sample": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "profile": {
          "const": "balanced",
          "type": "string"
        },
        "policy": {
          "const": "jev-general-v1",
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "counterfactual_test": {
          "type": "boolean"
        },
        "cell_grain": {
          "additionalProperties": {
            "enum": [
              "hour",
              "6h",
              "day"
            ],
            "type": "string"
          },
          "description": "Per sampled model, the bucket of the request-count query: hour, or coarser when hourly cells exceed the time-series budget.",
          "type": "object"
        }
      },
      "required": [
        "sample",
        "profile",
        "policy",
        "seed",
        "counterfactual_test"
      ],
      "type": "object"
    },
    "PerProfile": {
      "additionalProperties": {
        "type": "number"
      },
      "properties": {
        "balanced": {
          "type": "number"
        },
        "cost": {
          "type": "number"
        }
      },
      "required": [
        "balanced",
        "cost"
      ],
      "type": "object"
    },
    "ProfileFigure": {
      "properties": {
        "savings": {
          "type": "number"
        },
        "ci90": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "savings",
        "ci90"
      ],
      "type": "object"
    },
    "Profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ProfileFigure"
      },
      "properties": {
        "balanced": {
          "$ref": "#/$defs/ProfileFigure"
        },
        "cost": {
          "$ref": "#/$defs/ProfileFigure"
        }
      },
      "required": [
        "balanced",
        "cost"
      ],
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "model": {},
        "action": {
          "enum": [
            "router",
            "switch",
            "keep",
            "not_analysed"
          ],
          "type": "string"
        },
        "router_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "move": {
          "anyOf": [
            {
              "$ref": "#/$defs/Move"
            },
            {
              "type": "null"
            }
          ]
        },
        "today_move": {
          "anyOf": [
            {
              "$ref": "#/$defs/Move"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "enable": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spend_per_month": {
          "type": "number"
        },
        "saved_per_month": {
          "type": "number"
        },
        "pct_of_model_spend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_today_per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_after_enabling_per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampled_calls": {
          "type": "integer"
        },
        "small_sample": {
          "type": "boolean"
        },
        "share_hard": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "action",
        "router_key",
        "move",
        "today_move",
        "targets",
        "enable",
        "spend_per_month",
        "saved_per_month",
        "pct_of_model_spend",
        "saved_today_per_month",
        "saved_after_enabling_per_month",
        "sampled_calls",
        "small_sample",
        "share_hard"
      ],
      "type": "object"
    },
    "Recommendations": {
      "properties": {
        "router": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "type": "array"
        },
        "switch": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "type": "array"
        }
      },
      "required": [
        "router",
        "switch"
      ],
      "type": "object"
    },
    "Replacement": {
      "properties": {
        "model": {},
        "to": {}
      },
      "required": [
        "model",
        "to"
      ],
      "type": "object"
    },
    "RouterLever": {
      "properties": {
        "pct_of_spend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci90_per_month": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Share of spend on the models this lever's estimate covers."
        },
        "saved_today_per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_after_enabling_per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "without_top3_per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "enable": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "routers": {
          "items": {
            "$ref": "#/$defs/RouterSetup"
          },
          "type": "array"
        },
        "replacements": {
          "description": "Models with no pool to route over: the router figure serves them on their change-model target, so the router plan changes them too.",
          "items": {
            "$ref": "#/$defs/Replacement"
          },
          "type": "array"
        }
      },
      "required": [
        "pct_of_spend",
        "per_month",
        "ci90_per_month",
        "coverage",
        "saved_today_per_month",
        "saved_after_enabling_per_month",
        "without_top3_per_month",
        "enable",
        "routers",
        "replacements"
      ],
      "type": "object"
    },
    "RouterSetup": {
      "properties": {
        "model": {},
        "key": {},
        "pool": {}
      },
      "required": [
        "model",
        "key",
        "pool"
      ],
      "type": "object"
    },
    "Routing": {
      "properties": {
        "headline": {
          "$ref": "#/$defs/Headline"
        },
        "profiles": {
          "$ref": "#/$defs/Profiles"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/RoutingMove"
          },
          "type": "array"
        },
        "strata": {
          "items": {
            "$ref": "#/$defs/Stratum"
          },
          "type": "array"
        },
        "not_covered": {
          "items": {
            "$ref": "#/$defs/NotCovered"
          },
          "type": "array"
        },
        "buckets": {},
        "fallbacks": {},
        "underpowered": {},
        "pareto": {}
      },
      "required": [
        "headline",
        "profiles",
        "strata",
        "not_covered",
        "buckets",
        "fallbacks",
        "underpowered",
        "pareto"
      ],
      "type": "object"
    },
    "RoutingDecisionCost": {
      "properties": {
        "calls": {
          "type": "integer"
        },
        "estimated_usd": {
          "type": "number"
        }
      },
      "required": [
        "calls",
        "estimated_usd"
      ],
      "type": "object"
    },
    "RoutingMove": {
      "properties": {
        "used": {
          "type": "string"
        },
        "pick": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "fallback": {
          "type": "integer"
        },
        "weight": {
          "type": "number"
        }
      },
      "required": [
        "used",
        "pick",
        "n",
        "fallback"
      ],
      "type": "object"
    },
    "Sample": {
      "properties": {
        "trace_id": {},
        "span_id": {},
        "model": {},
        "weight": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "cur_price": {
          "type": "number"
        },
        "billed": {
          "type": "number"
        },
        "savings": {
          "$ref": "#/$defs/PerProfile"
        },
        "picks": {
          "type": "object"
        },
        "fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "model",
        "weight",
        "cur_price",
        "billed",
        "savings",
        "picks",
        "fallback"
      ],
      "type": "object"
    },
    "SampledMove": {
      "properties": {
        "used": {},
        "pick": {},
        "tier": {},
        "n": {},
        "fallback": {},
        "costs_more": {},
        "weighted_savings": {}
      },
      "required": [
        "used",
        "pick",
        "tier",
        "n",
        "fallback",
        "costs_more",
        "weighted_savings"
      ],
      "type": "object"
    },
    "Scenario": {
      "properties": {
        "scope": {
          "enum": [
            "same_provider:all",
            "same_provider:enabled",
            "any_provider:all",
            "any_provider:enabled"
          ],
          "type": "string"
        },
        "provider": {
          "enum": [
            "same_provider",
            "any_provider"
          ],
          "type": "string"
        },
        "availability": {
          "enum": [
            "all",
            "enabled"
          ],
          "type": "string"
        },
        "headline": {
          "type": "boolean"
        },
        "router": {
          "$ref": "#/$defs/ScenarioRouter"
        },
        "switch": {
          "$ref": "#/$defs/Estimate"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ScenarioModel"
          },
          "type": "array"
        }
      },
      "required": [
        "scope",
        "provider",
        "availability",
        "headline",
        "router",
        "switch",
        "models"
      ],
      "type": "object"
    },
    "ScenarioModel": {
      "properties": {
        "model": {
          "type": "string"
        },
        "pool": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "switch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "enable": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relaxed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "pool",
        "switch",
        "enable",
        "relaxed",
        "reason"
      ],
      "type": "object"
    },
    "ScenarioRouter": {
      "additionalProperties": {
        "$ref": "#/$defs/Estimate"
      },
      "properties": {
        "balanced": {
          "$ref": "#/$defs/Estimate"
        },
        "cost": {
          "$ref": "#/$defs/Estimate"
        }
      },
      "required": [
        "balanced",
        "cost"
      ],
      "type": "object"
    },
    "ScopeLever": {
      "properties": {
        "pct_of_spend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "per_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci90_per_month": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "enable": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pct_of_spend",
        "per_month",
        "ci90_per_month",
        "coverage",
        "enable"
      ],
      "type": "object"
    },
    "ScopeModel": {
      "properties": {
        "model": {},
        "pool": {},
        "switch": {},
        "enable": {}
      },
      "required": [
        "model",
        "pool",
        "switch",
        "enable"
      ],
      "type": "object"
    },
    "Spend": {
      "properties": {
        "total": {
          "type": "number"
        },
        "per_month": {
          "type": "number"
        },
        "by_model": {
          "items": {
            "$ref": "#/$defs/SpendRow"
          },
          "type": "array"
        },
        "by_agent": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SpendRow"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "by_deployment": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SpendRow"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "total",
        "per_month",
        "by_model"
      ],
      "type": "object"
    },
    "SpendRow": {
      "properties": {
        "key": {
          "type": "string"
        },
        "spend": {
          "type": "number"
        }
      },
      "required": [
        "key",
        "spend"
      ],
      "type": "object"
    },
    "StopInfo": {
      "properties": {
        "check": {
          "type": "string"
        },
        "numbers": {
          "type": "object"
        }
      },
      "required": [
        "check",
        "numbers"
      ],
      "type": "object"
    },
    "StoppingCheck": {
      "properties": {
        "check": {
          "type": "string"
        },
        "pass": {
          "type": "boolean"
        },
        "numbers": {
          "type": "object"
        }
      },
      "required": [
        "check",
        "pass",
        "numbers"
      ],
      "type": "object"
    },
    "Stratum": {
      "properties": {
        "model": {
          "type": "string"
        },
        "spend": {
          "type": "number"
        },
        "n": {
          "type": "integer"
        },
        "clusters": {
          "type": "integer"
        },
        "covered": {
          "type": "boolean"
        },
        "savings": {
          "anyOf": [
            {
              "type": "number"
            },
            {
