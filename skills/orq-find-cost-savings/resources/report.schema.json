{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orq-find-cost-savings report.json",
  "type": "object",
  "required": ["schema_version", "generated_at", "workspace", "status", "stop", "params", "checks"],
  "if": {"properties": {"status": {"const": "ok"}}, "required": ["status", "routing"]},
  "then": {"required": ["summary"]},
  "allOf": [{"if": {"properties": {"params": {"properties": {"counterfactual_test": {"const": true}}, "required": ["counterfactual_test"]}, "status": {"const": "ok"}}, "required": ["params", "status"]}, "then": {"required": ["counterfactual_test"]}}],
  "properties": {
    "schema_version": {"const": "1.2"},
    "generated_at": {"type": "string"},
    "workspace": {"type": ["string", "null"]},
    "status": {"enum": ["ok", "stopped"]},
    "stop": {
      "type": ["object", "null"],
      "required": ["check", "numbers"],
      "properties": {"check": {"type": "string"}, "numbers": {"type": "object"}}
    },
    "summary": {
      "description": "Written by analyze on a finished run: every number the page shows. render only formats these; it does not recompute them.",
      "type": "object",
      "required": ["window", "spend_total", "spend_per_month", "scope", "sampled_calls", "recommended",
                   "levers_overlap", "router", "switch", "recommendations", "scopes", "not_analysed", "sampled_moves",
                   "caching", "caveats"],
      "properties": {
        "spend_total": {"type": ["number", "null"]}, "spend_per_month": {"type": ["number", "null"]},
        "recommended": {"enum": ["router", "switch", null], "description": "null when neither lever saves anything (per_month <= 0 or null)."},
        "levers_overlap": {"type": "boolean"},
        "sampled_calls": {"type": ["integer", "null"]},
        "caveats": {"type": "array"},
        "window": {"type": "object", "required": ["from", "to", "days", "requested", "retention"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "days": {"type": "integer"}, "requested": {"type": ["integer", "null"]}, "retention": {"type": ["integer", "null"]}}},
        "caching": {"type": "object", "required": ["threads_scanned", "savings_found", "cached_share", "saved_by_cache", "threads_caching", "error", "rows"], "properties": {"threads_scanned": {"type": ["integer", "null"]}, "savings_found": {"type": ["number", "null"]}, "error": {"type": ["string", "null"]},
                    "cached_share": {"type": ["number", "null"], "description": "Share of input tokens in the scanned threads already read from cache."}, "saved_by_cache": {"type": ["number", "null"], "description": "What those cache reads saved against the input price, in the scanned threads."}, "threads_caching": {"type": ["integer", "null"], "description": "Scanned threads with a model already reading 20% or more of its input from cache."},
                    "rows": {"description": "Up to 20 candidate threads, largest saving first.", "type": "array", "items": {"type": "object", "required": ["thread", "agent", "model", "turns", "savings", "action"]}}}},
        "sampled_moves": {"description": "Per (model in use, balanced pick) in the headline scope: sampled calls, fallbacks among them, and their saving.", "type": "array", "items": {"type": "object", "required": ["used", "pick", "tier", "n", "fallback", "costs_more", "weighted_savings"]}},
        "router": {
          "type": "object",
          "required": ["pct_of_spend", "per_month", "ci90_per_month", "coverage", "saved_today_per_month",
                       "saved_after_enabling_per_month", "enable", "routers", "replacements", "without_top3_per_month"],
          "properties": {
            "pct_of_spend": {"type": ["number", "null"]}, "per_month": {"type": ["number", "null"]}, "ci90_per_month": {"type": ["array", "null"], "items": {"type": "number"}},
            "coverage": {"type": ["number", "null"], "description": "Share of spend on the models this lever's estimate covers."},
            "saved_today_per_month": {"type": ["number", "null"]}, "saved_after_enabling_per_month": {"type": ["number", "null"]},
            "without_top3_per_month": {"type": ["number", "null"]},
            "enable": {"type": "array", "items": {"type": "string"}},
            "routers": {"type": "array", "items": {"type": "object", "required": ["model", "key", "pool"]}},
            "replacements": {"description": "Models with no pool to route over: the router figure serves them on their change-model target, so the router plan changes them too.", "type": "array", "items": {"type": "object", "required": ["model", "to"]}}
          }
        },
        "switch": {
          "type": "object",
          "required": ["pct_of_spend", "per_month", "ci90_per_month", "coverage", "saved_today_per_month",
                       "saved_after_enabling_per_month", "enable", "replacements"],
          "properties": {
            "pct_of_spend": {"type": ["number", "null"]}, "per_month": {"type": ["number", "null"]}, "ci90_per_month": {"type": ["array", "null"], "items": {"type": "number"}},
            "coverage": {"type": ["number", "null"], "description": "Share of spend on the models this lever's estimate covers."},
            "saved_today_per_month": {"type": ["number", "null"]}, "saved_after_enabling_per_month": {"type": ["number", "null"]},
            "enable": {"type": "array", "items": {"type": "string"}},
            "replacements": {"type": "array", "items": {"type": "object", "required": ["model", "to"]}}
          }
        },
        "recommendations": {
          "description": "One row per sampled model, per lever; action keep means no cheaper model is as strong, not_analysed that the lever's estimate does not cover the model.",
          "type": "object",
          "required": ["router", "switch"],
          "properties": {"router": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model", "action", "router_key", "move", "today_move", "targets", "enable", "spend_per_month",
                           "saved_per_month", "pct_of_model_spend", "saved_today_per_month",
                           "saved_after_enabling_per_month", "sampled_calls", "small_sample", "share_hard"],
              "properties": {
                "action": {"enum": ["router", "switch", "keep", "not_analysed"]},
                "router_key": {"type": ["string", "null"]},
                "move": {"type": ["object", "null"], "required": ["pool", "switch"], "properties": {"pool": {"type": ["array", "null"], "items": {"type": "string"}}, "switch": {"type": ["string", "null"]}}},
                "today_move": {"type": ["object", "null"], "required": ["pool", "switch"], "properties": {"pool": {"type": ["array", "null"], "items": {"type": "string"}}, "switch": {"type": ["string", "null"]}}},
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["model", "share_of_calls", "tiers", "unscored_calls", "enable", "stays"],
                    "properties": {"share_of_calls": {"type": ["number", "null"]}, "tiers": {"type": "array", "items": {"type": "string"}}, "unscored_calls": {"type": "integer"},
                                   "enable": {"type": "boolean"}, "stays": {"type": "boolean"}}
                  }
                },
                "enable": {"type": "array", "items": {"type": "string"}},
                "spend_per_month": {"type": "number"}, "saved_per_month": {"type": "number"},
                "pct_of_model_spend": {"type": ["number", "null"]}, "saved_today_per_month": {"type": ["number", "null"]}, "saved_after_enabling_per_month": {"type": ["number", "null"]},
                "sampled_calls": {"type": "integer"}, "small_sample": {"type": "boolean"}, "share_hard": {"type": ["number", "null"]}
              }
            }
          }, "switch": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model", "action", "router_key", "move", "today_move", "targets", "enable", "spend_per_month",
                           "saved_per_month", "pct_of_model_spend", "saved_today_per_month",
                           "saved_after_enabling_per_month", "sampled_calls", "small_sample", "share_hard"],
              "properties": {
                "action": {"enum": ["router", "switch", "keep", "not_analysed"]},
                "router_key": {"type": ["string", "null"]},
                "move": {"type": ["object", "null"], "required": ["pool", "switch"], "properties": {"pool": {"type": ["array", "null"], "items": {"type": "string"}}, "switch": {"type": ["string", "null"]}}},
                "today_move": {"type": ["object", "null"], "required": ["pool", "switch"], "properties": {"pool": {"type": ["array", "null"], "items": {"type": "string"}}, "switch": {"type": ["string", "null"]}}},
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["model", "share_of_calls", "tiers", "unscored_calls", "enable", "stays"],
                    "properties": {"share_of_calls": {"type": ["number", "null"]}, "tiers": {"type": "array", "items": {"type": "string"}}, "unscored_calls": {"type": "integer"},
                                   "enable": {"type": "boolean"}, "stays": {"type": "boolean"}}
                  }
                },
                "enable": {"type": "array", "items": {"type": "string"}},
                "spend_per_month": {"type": "number"}, "saved_per_month": {"type": "number"},
                "pct_of_model_spend": {"type": ["number", "null"]}, "saved_today_per_month": {"type": ["number", "null"]}, "saved_after_enabling_per_month": {"type": ["number", "null"]},
                "sampled_calls": {"type": "integer"}, "small_sample": {"type": "boolean"}, "share_hard": {"type": ["number", "null"]}
              }
            }
          }}
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scope", "headline", "router", "switch", "models"],
            "properties": {"headline": {"type": "boolean"}, "router": {"$ref": "#/$defs/scopeLever"}, "switch": {"$ref": "#/$defs/scopeLever"},
                           "models": {"type": "array", "items": {"type": "object", "required": ["model", "pool", "switch", "enable"]}}}
          }
        },
        "not_analysed": {"type": "object", "required": ["per_month", "model_count"],
                         "properties": {"per_month": {"type": "number"}, "model_count": {"type": "integer"}}}
      }
    },
    "params": {
      "type": "object",
      "required": ["sample", "profile", "policy", "seed", "counterfactual_test"],
      "properties": {
        "sample": {"type": "integer", "minimum": 1, "maximum": 100},
        "profile": {"const": "balanced"},
        "policy": {"const": "jev-general-v1"},
        "seed": {"type": "integer"},
        "counterfactual_test": {"type": "boolean"},
        "cell_grain": {"description": "Per sampled model, the bucket of the request-count query: hour, or coarser when hourly cells exceed the time-series budget.", "type": "object", "additionalProperties": {"enum": ["hour", "6h", "day"]}}
      }
    },
    "window": {
      "type": "object",
      "required": ["from", "to", "days"],
      "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "days": {"type": "integer", "minimum": 1},
                     "requested": {"type": "integer", "minimum": 1},
                     "retention": {"type": ["integer", "null"], "minimum": 1}}
    },
    "spend": {
      "type": "object",
      "required": ["total", "per_month", "by_model"],
      "properties": {
        "total": {"type": "number"},
        "per_month": {"type": "number"},
        "by_model": {"$ref": "#/$defs/spendRows"},
        "by_agent": {"anyOf": [{"$ref": "#/$defs/spendRows"}, {"type": "null"}]},
        "by_deployment": {"anyOf": [{"$ref": "#/$defs/spendRows"}, {"type": "null"}]}
      }
    },
    "routing_decision_cost": {
      "type": "object",
      "required": ["calls", "estimated_usd"],
      "properties": {"calls": {"type": "integer"}, "estimated_usd": {"type": "number"}}
    },
    "checks": {
      "type": "object",
      "required": ["stopping", "caveats"],
      "properties": {
        "stopping": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check", "pass", "numbers"],
            "properties": {"check": {"type": "string"}, "pass": {"type": "boolean"}, "numbers": {"type": "object"}}
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check", "detail"],
            "properties": {"check": {"type": "string"}, "detail": {"type": "string"}}
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trace_id", "span_id", "model", "weight", "cur_price", "billed", "savings", "picks", "fallback"],
        "properties": {
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "cur_price": {"type": "number"},
          "billed": {"type": "number"},
          "savings": {"$ref": "#/$defs/perProfile"},
          "picks": {"type": "object"},
          "fallback": {"type": ["string", "null"]}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["scope", "provider", "availability", "headline", "router", "switch", "models"],
        "properties": {
          "scope": {"enum": ["same_provider:all", "same_provider:enabled", "any_provider:all", "any_provider:enabled"]},
          "provider": {"enum": ["same_provider", "any_provider"]},
          "availability": {"enum": ["all", "enabled"]},
          "headline": {"type": "boolean"},
          "router": {
            "type": "object",
            "required": ["balanced", "cost"],
            "additionalProperties": {"$ref": "#/$defs/estimate"}
          },
          "switch": {"$ref": "#/$defs/estimate"},
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model", "pool", "switch", "enable", "relaxed", "reason"],
              "properties": {
                "model": {"type": "string"},
                "pool": {"type": ["array", "null"], "items": {"type": "string"}},
                "switch": {"type": ["string", "null"]},
                "enable": {"type": "array", "items": {"type": "string"}},
                "relaxed": {"type": "boolean"},
                "reason": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "required": ["headline", "profiles", "strata", "not_covered", "buckets", "fallbacks", "underpowered", "pareto"],
      "properties": {
        "headline": {
          "type": "object",
          "required": ["savings", "ci90", "without_top3", "coverage", "per_month", "ci90_per_month"],
          "properties": {
            "savings": {"type": "number"},
            "ci90": {"$ref": "#/$defs/interval"},
            "without_top3": {"type": "number"},
            "coverage": {"type": "number", "minimum": 0, "maximum": 1},
            "per_month": {"type": "number"},
            "ci90_per_month": {"$ref": "#/$defs/interval"}
          }
        },
        "profiles": {
          "type": "object",
          "required": ["balanced", "cost"],
          "additionalProperties": {
            "type": "object",
            "required": ["savings", "ci90"],
            "properties": {"savings": {"type": "number"}, "ci90": {"$ref": "#/$defs/interval"}}
          }
        },
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["used", "pick", "n", "fallback"],
            "properties": {
              "used": {"type": "string"},
              "pick": {"type": "string"},
              "n": {"type": "integer"},
              "fallback": {"type": "integer"},
              "weight": {"type": "number"}
            }
          }
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "spend", "n", "clusters", "covered", "pool", "pool_reason"],
            "properties": {
              "model": {"type": "string"},
              "spend": {"type": "number"},
              "n": {"type": "integer"},
              "clusters": {"type": "integer"},
              "covered": {"type": "boolean"},
              "savings": {"type": ["number", "null"]},
              "pool": {"type": ["array", "null"], "items": {"type": "string"}}
            }
          }
        },
        "not_covered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "spend", "reason"],
            "properties": {"model": {"type": "string"}, "spend": {"type": "number"}, "reason": {"type": "string"}}
          }
        }
      }
    },
    "counterfactual_test": {
      "type": "object",
      "required": ["asks", "per_model"],
      "properties": {
        "asks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["span_id", "used", "recommended", "differs"],
            "properties": {"differs": {"type": "boolean"}}
          }
        },
        "per_model": {"type": "object"}
      }
    },
    "caching": {
      "type": "object",
      "properties": {
        "threads_scanned": {"type": "integer"},
        "label": {"type": "string"},
        "savings_found": {"type": "number"},
        "savings_orq": {"type": "number"},
        "cached_share": {"type": ["number", "null"]},
        "saved_by_cache": {"type": "number"},
        "threads_caching": {"type": "integer"},
        "rows": {"type": "array"},
        "error": {"type": "string"}
      }
    },
    "harness": {
      "type": "object",
      "properties": {"metric": {"type": "string"}, "rows": {"type": "array"}, "unattributed": {"type": ["number", "null"]}}
    }
  },
  "$defs": {
    "scopeLever": {
      "type": "object",
      "required": ["pct_of_spend", "per_month", "ci90_per_month", "coverage", "enable"],
      "properties": {"pct_of_spend": {"type": ["number", "null"]}, "per_month": {"type": ["number", "null"]}, "ci90_per_month": {"type": ["array", "null"], "items": {"type": "number"}},
                     "coverage": {"type": ["number", "null"]}, "enable": {"type": "array", "items": {"type": "string"}}}
    },
    "interval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "estimate": {
      "type": "object",
      "required": ["savings", "ci90", "coverage", "per_month", "ci90_per_month", "without_top3", "unpriced_models"],
      "properties": {
        "savings": {"type": "number"},
        "ci90": {"$ref": "#/$defs/interval"},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "per_month": {"type": "number"},
        "ci90_per_month": {"$ref": "#/$defs/interval"},
        "without_top3": {"type": "number"},
        "unpriced_models": {"type": "array", "items": {"type": "string"}},
        "per_stratum": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}
      }
    },
    "perProfile": {
      "type": "object",
      "required": ["balanced", "cost"],
      "additionalProperties": {"type": "number"}
    },
    "spendRows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "spend"],
        "properties": {"key": {"type": "string"}, "spend": {"type": "number"}}
      }
    }
  }
}
